{
  "name": "ai-care-coordinator",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/backend",
    "packages/frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:backend": "bash scripts/build-backend.sh",
    "build:frontend": "bash scripts/build-frontend.sh",
    "deploy": "bash scripts/deploy.sh",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.1",
    "fast-check": "^4.1.1"
  }
}
